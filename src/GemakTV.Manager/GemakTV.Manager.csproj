<Project Sdk="Microsoft.NET.Sdk">
  <!-- The family's phone app: sign in with the GemakTV GitHub account, choose channels, save them for the TV. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>GemakTV.Manager</RootNamespace>
    <ApplicationId>io.github.ryusch.gemaktv.manager</ApplicationId>
    <ApplicationTitle>GemakTV Manager</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(GemakEmulator)' == 'true'">android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <GemakEmbedConfigKey>true</GemakEmbedConfigKey>
    <GemakSignApk>true</GemakSignApk>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GemakTV.Infrastructure\GemakTV.Infrastructure.csproj" />
    <ProjectReference Include="..\GemakTV.Platform\GemakTV.Platform.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\Secrets.props" />
</Project>
