<?xml version="1.0" encoding="utf-8"?>
<!-- One screen: full-screen video with overlays on top. Only one overlay is visible at a time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

  <androidx.media3.ui.PlayerView
      android:id="@+id/player_view"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:focusable="false"
      app:use_controller="false"
      app:resize_mode="fit"
      app:surface_type="surface_view"
      app:show_buffering="never"
      app:shutter_background_color="@android:color/black" />

  <!-- Tuning in / not available / no internet -->
  <LinearLayout
      android:id="@+id/status_card"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="top|center_horizontal"
      android:layout_marginTop="48dp"
      android:minWidth="620dp"
      android:maxWidth="760dp"
      android:background="@drawable/panel_background"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingStart="44dp"
      android:paddingEnd="44dp"
      android:paddingTop="28dp"
      android:paddingBottom="30dp"
      android:visibility="gone">
    <!-- Sits in the upper part of the screen so the channel banner at the bottom never covers it. -->

    <ProgressBar
        android:id="@+id/status_spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/accent" />

    <ImageView
        android:id="@+id/status_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:tint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status_title"
        style="@style/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/status_detail"
        style="@style/Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center" />
  </LinearLayout>

  <!-- Channel name banner, shown for a few seconds after switching channel -->
  <LinearLayout
      android:id="@+id/banner"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|start"
      android:layout_margin="48dp"
      android:background="@drawable/banner_background"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="24dp"
      android:visibility="gone">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/logo_frame">

      <ImageView
          android:id="@+id/banner_logo"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:padding="10dp"
          android:scaleType="fitCenter" />

      <TextView
          android:id="@+id/banner_letter"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="@color/ink"
          android:textSize="56sp"
          android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:orientation="vertical">

      <TextView
          android:id="@+id/banner_number"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:letterSpacing="0.08"
          android:textColor="@color/accent"
          android:textSize="22sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/banner_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxWidth="620dp"
          android:singleLine="true"
          android:textColor="@color/text_primary"
          android:textSize="46sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/banner_hint"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/banner_hint"
          android:textColor="@color/text_secondary"
          android:textSize="21sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/banner_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:textColor="@color/text_primary"
        android:textSize="36sp" />
  </LinearLayout>

  <!-- Menu: channels on the left, the two big buttons on the right -->
  <LinearLayout
      android:id="@+id/menu"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/scrim"
      android:orientation="horizontal"
      android:paddingStart="64dp"
      android:paddingEnd="64dp"
      android:paddingTop="48dp"
      android:paddingBottom="40dp"
      android:visibility="gone">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:orientation="vertical">

      <TextView
          style="@style/Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="20dp"
          android:text="@string/menu_channels" />

      <ScrollView
          android:id="@+id/channel_scroll"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:clipToPadding="false"
          android:fadingEdgeLength="32dp"
          android:requiresFadingEdge="vertical"
          android:scrollbars="none">

        <LinearLayout
            android:id="@+id/channel_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp" />
      </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="56dp"
        android:layout_weight="1"
        android:orientation="vertical">

      <TextView
          android:id="@+id/menu_clock"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/text_primary"
          android:textSize="64sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/menu_date"
          style="@style/Body"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="36dp"
          android:textSize="28sp" />

      <TextView
          android:id="@+id/btn_check_channels"
          style="@style/ActionCard"
          android:drawableStart="@drawable/ic_channel_list"
          android:text="@string/check_channels" />

      <TextView
          android:id="@+id/btn_check_updates"
          style="@style/ActionCard"
          android:drawableStart="@drawable/ic_update"
          android:text="@string/check_updates" />

      <Space
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1" />

      <TextView
          style="@style/Body"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/menu_help" />

      <TextView
          android:id="@+id/version_text"
          style="@style/Body"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:alpha="0.7"
          android:textSize="18sp" />
    </LinearLayout>
  </LinearLayout>

  <!-- Messages and update progress -->
  <FrameLayout
      android:id="@+id/dialog"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/scrim"
      android:clickable="true"
      android:visibility="gone">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="48dp">

      <ProgressBar
          android:id="@+id/dialog_spinner"
          android:layout_width="80dp"
          android:layout_height="80dp"
          android:indeterminateTint="@color/accent" />

      <ImageView
          android:id="@+id/dialog_icon"
          android:layout_width="80dp"
          android:layout_height="80dp"
          android:tint="@color/accent"
          android:visibility="gone" />

      <TextView
          android:id="@+id/dialog_title"
          style="@style/Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:gravity="center"
          android:textSize="38sp" />

      <TextView
          android:id="@+id/dialog_message"
          style="@style/Body"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:gravity="center"
          android:textSize="27sp" />

      <ProgressBar
          android:id="@+id/dialog_progress"
          style="@android:style/Widget.ProgressBar.Horizontal"
          android:layout_width="match_parent"
          android:layout_height="20dp"
          android:layout_marginTop="28dp"
          android:max="1000"
          android:progressDrawable="@drawable/progress_bar"
          android:visibility="gone" />

      <TextView
          android:id="@+id/dialog_button"
          style="@style/ActionCard"
          android:layout_width="320dp"
          android:layout_marginTop="36dp"
          android:layout_marginBottom="0dp"
          android:gravity="center"
          android:text="@string/ok"
          android:textSize="32sp" />
    </LinearLayout>
  </FrameLayout>

  <!-- Hidden maintenance panel for a visiting helper (see docs/SETUP.md for the key sequence) -->
  <FrameLayout
      android:id="@+id/maintenance"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/scrim"
      android:clickable="true"
      android:visibility="gone">

    <!-- 2 x 2 grid so it fits a 720p box as well as a 1080p one -->
    <LinearLayout
        android:layout_width="860dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="40dp">

      <TextView
          style="@style/Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/maintenance_title" />

      <TextView
          android:id="@+id/maintenance_info"
          style="@style/Body"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:layout_marginBottom="24dp"
          android:textSize="18sp" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

        <TextView
            android:id="@+id/maint_wifi"
            style="@style/ActionCard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:minHeight="88dp"
            android:drawableStart="@drawable/ic_wifi"
            android:text="@string/maint_wifi"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/maint_settings"
            style="@style/ActionCard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:minHeight="88dp"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/maint_settings"
            android:textSize="24sp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

        <TextView
            android:id="@+id/maint_exit"
            style="@style/ActionCard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="0dp"
            android:minHeight="88dp"
            android:drawableStart="@drawable/ic_logout"
            android:text="@string/maint_exit"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/maint_close"
            style="@style/ActionCard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="0dp"
            android:minHeight="88dp"
            android:drawableStart="@drawable/ic_close"
            android:text="@string/maint_close"
            android:textSize="24sp" />
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
