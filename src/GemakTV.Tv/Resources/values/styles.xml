<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="GemakTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
    <item name="android:windowBackground">@drawable/splash</item>
    <item name="android:colorAccent">@color/accent</item>
    <item name="android:colorPrimary">@color/ink</item>
    <item name="android:windowContentOverlay">@null</item>
  </style>

  <!-- Large, high-contrast, remote-friendly button: the focused one turns amber with a white edge. -->
  <style name="ActionCard">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">104dp</item>
    <item name="android:layout_marginBottom">20dp</item>
    <item name="android:paddingStart">28dp</item>
    <item name="android:paddingEnd">28dp</item>
    <item name="android:paddingTop">18dp</item>
    <item name="android:paddingBottom">18dp</item>
    <item name="android:background">@drawable/card_selector</item>
    <item name="android:focusable">true</item>
    <item name="android:clickable">true</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:textSize">28sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/card_text</item>
    <item name="android:drawablePadding">24dp</item>
    <item name="android:drawableTint">@color/card_text</item>
  </style>

  <style name="Title">
    <item name="android:textSize">34sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/text_primary</item>
  </style>

  <style name="Body">
    <item name="android:textSize">24sp</item>
    <item name="android:textColor">@color/text_secondary</item>
    <item name="android:lineSpacingMultiplier">1.15</item>
  </style>
</resources>
