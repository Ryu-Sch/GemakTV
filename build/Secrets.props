<Project>
  <!--
    Imported by the two Android apps and the publisher tool.

    The secrets folder is never inside the repository. It holds:
      gemaktv.keystore  - the app signing key (PKCS#12, alias "gemaktv")
      keystore.pass     - its password
      config.key        - 32-byte key derived from the signing key; encrypts the published config and APKs

    Create it once with:  dotnet tools/GemakTV.Publisher/bin/Release/net10.0/GemakTV.Publisher.dll keys create
    Override the location with the GEMAKTV_SECRETS environment variable.
  -->
  <PropertyGroup>
    <GemakSecretsDir Condition="'$(GemakSecretsDir)' == '' and '$(GEMAKTV_SECRETS)' != ''">$(GEMAKTV_SECRETS)</GemakSecretsDir>
    <GemakSecretsDir Condition="'$(GemakSecretsDir)' == '' and '$(USERPROFILE)' != ''">$(USERPROFILE)\.gemaktv</GemakSecretsDir>
    <GemakSecretsDir Condition="'$(GemakSecretsDir)' == ''">$(HOME)/.gemaktv</GemakSecretsDir>
    <GemakSecretsDir>$([MSBuild]::EnsureTrailingSlash('$(GemakSecretsDir)'))</GemakSecretsDir>
    <GemakConfigKey>$(GemakSecretsDir)config.key</GemakConfigKey>
    <GemakKeystore>$(GemakSecretsDir)gemaktv.keystore</GemakKeystore>
  </PropertyGroup>

  <ItemGroup Condition="'$(GemakEmbedConfigKey)' == 'true' and Exists('$(GemakConfigKey)')">
    <EmbeddedResource Include="$(GemakConfigKey)" LogicalName="GemakTV.config.key" Visible="false" />
  </ItemGroup>

  <Target Name="GemakRequireConfigKey" BeforeTargets="BeforeBuild"
          Condition="'$(GemakEmbedConfigKey)' == 'true' and !Exists('$(GemakConfigKey)')">
    <Error Text="GemakTV: no config key at $(GemakConfigKey). Run 'keys create' with the publisher tool once (see docs/SETUP.md), or point GEMAKTV_SECRETS at your secrets folder." />
  </Target>

  <!-- Every build of the apps is signed with the real key when it is available,
       so a test build on the emulator can self-update to a published release. -->
  <PropertyGroup Condition="'$(GemakSignApk)' == 'true' and Exists('$(GemakKeystore)')">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(GemakKeystore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>gemaktv</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>file:$(GemakSecretsDir)keystore.pass</AndroidSigningStorePass>
    <AndroidSigningKeyPass>file:$(GemakSecretsDir)keystore.pass</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Repository coordinates baked into the apps (see Directory.Build.props). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GemakRepo</_Parameter1>
      <_Parameter2>$(GemakRepoOwner)/$(GemakRepoName)@$(GemakPublishBranch)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
